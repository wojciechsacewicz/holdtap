pkgname=holdtap
pkgver=0.1.3
pkgrel=1
pkgdesc='Second-finger tap-to-click filter for Linux multitouch touchpads'
arch=('x86_64')
url='https://github.com/wojciechsacewicz/holdtap'
license=('MIT')
depends=('glibc')
makedepends=('cargo')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --release --locked
}

check() {
  cd "$startdir/.."
  cargo test --locked
}

package() {
  install -Dm755 "$startdir/../target/release/holdtap" \
    "$pkgdir/usr/bin/holdtap"
  install -Dm644 "$startdir/holdtap.service" \
    "$pkgdir/usr/lib/systemd/system/holdtap.service"
  install -Dm644 "$startdir/../README.md" \
    "$pkgdir/usr/share/doc/holdtap/README.md"
}
